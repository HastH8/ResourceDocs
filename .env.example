GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public canonical origin used by metadata, Open Graph, robots, and sitemap.
# Vercel deployment URLs are detected automatically; set this for a custom domain.
NEXT_PUBLIC_SITE_URL=https://res.hastherish.com

# Optional usage controls for production deployments.
DAILY_GENERATION_LIMIT=25
MAX_UPLOAD_MB=50
